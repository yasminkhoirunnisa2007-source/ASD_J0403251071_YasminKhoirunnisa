def bubbleSort(data):
    n = len(data)

    for i in range(n):
        for j in range(0, n-i-1):

            if data[j] > data[j+1]:
                temp = data[j]
                data[j] = data[j+1]
                data[j+1] = temp

        return data
    
data = [3,5,4,2,8,1,7,6]
bubbleSort(data)
print("data yang sudah terurut:", data)